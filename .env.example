# Auth token for API access (generate a random string). Also used as the HMAC
# secret for short-lived signed proxy URLs.
DMM_AUTH_TOKEN=your-secret-token-here

# Master protection switch. on/true/1/yes = enable (token + signed URL + rate
# limit + optional IP whitelist); off/empty = no restrictions (fully open).
DMM_API_PROTECT=on

# Signed proxy URL validity window, in seconds (default 220)
DMM_SIGN_TTL=220

# Per-IP request budget per minute when protection is enabled (default 240)
DMM_RATE_PER_MIN=240

# Optional client-IP whitelist: comma-separated IPs and/or CIDR blocks.
# Leave empty to allow all IPs (rely on token + signature + rate limiting).
# e.g. DMM_ALLOW_IPS=1.2.3.4,203.0.113.0/24
DMM_ALLOW_IPS=

# Server port
DMM_PROXY_PORT=80
DMM_PROXY_SSL_PORT=443

# SSL certificate paths (optional, for HTTPS)
# SSL_CERT_PATH=/etc/ssl/certs/dmm-proxy.crt
# SSL_KEY_PATH=/etc/ssl/private/dmm-proxy.key
/etc/ssl/api-dmmrsc.131433.xyz/private.key
/etc/ssl/api-dmmrsc.131433.xyz/fullchain.pem